<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6c74c172-9213-4446-ba2f-ddcf841a4497</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test được truy cập kiểu internal (entity, handler) mà không phải để public (ADR-001). -->
    <InternalsVisibleTo Include="server.UnitTests" />
    <InternalsVisibleTo Include="server.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dữ liệu demo của catalog (ADR-010), đọc bằng GetManifestResourceStream — không phụ thuộc thư mục chạy. -->
    <EmbeddedResource Include="Modules/Catalog/Seeding/demo-catalog.json" LogicalName="server.Modules.Catalog.Seeding.demo-catalog.json" />
    <Content Remove="Modules/Catalog/Seeding/demo-catalog.json" />
    <!-- Mật khẩu phổ biến (ADR-012 §2), đọc một lần khi khởi động. -->
    <EmbeddedResource Include="Modules/Identity/Domain/common-passwords.txt" LogicalName="server.Modules.Identity.Domain.common-passwords.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-012: JwtBearer (xác thực access token) + Identity.Core (chỉ PasswordHasher<T>). Gói của Microsoft, ghim bản. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
