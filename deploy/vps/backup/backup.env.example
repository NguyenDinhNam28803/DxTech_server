# Cấu hình backup DXTechs — đặt tại ~/.config/dxtechs-backup/backup.env, chmod 600 (script từ chối nếu rộng hơn).
# KHÔNG commit file thật. KHÔNG gửi nội dung file này qua chat.

# Backup trên VPS
# BACKUP_DIR=/home/deploy/backups   (mặc định: ~/backups)
# KEEP_DAYS=7

# Bản sao ngoài VPS: none | s3 | dir
#   s3  = kho lưu trữ tương thích S3 (khuyến nghị) — dùng khoá CHỈ ĐƯỢC GHI (PutObject), không được xoá/đọc
#   dir = thư mục đã mount từ ổ/máy khác (NFS, ổ gắn ngoài...)
OFFSITE=none
OFFSITE_PREFIX=dxtechs

# Public key GPG để mã hoá (KHÔNG BAO GIỜ đặt private key trên VPS)
# GPG_RECIPIENT_FILE=/home/deploy/.config/dxtechs-backup/recipient.asc

# --- OFFSITE=s3 ---
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=dxtechs-backup
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- OFFSITE=dir ---
# OFFSITE_DIR=/mnt/offsite-backup

# Cảnh báo khi backup không chạy / lỗi (tuỳ chọn): dịch vụ "dead man's switch" kiểu healthchecks
# — gọi URL OK mỗi lần thành công; dịch vụ báo động nếu quá 26 giờ không nhận được.
# BACKUP_PING_URL=
# BACKUP_PING_FAIL_URL=

# Số bảng có dữ liệu tối thiểu trong dump (chặn dump bị cắt cụt). Hiện có 4: migrations + 3 bảng catalog.
MIN_TABLES=4
